@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<h1>Welcome to Budget Tracker</h1>
<p>Track your expenses, set a budget, and stay on target.</p>

<h2>Set Your Budget</h2>
<form method="post" asp-page-handler="SetBudget" class="row gy-2 gx-3 align-items-center mb-4">
    <div class="col-auto">
        <label class="visually-hidden" for="budget">Budget</label>
        <input type="number" step="0.01" class="form-control" id="budget" name="Budget" placeholder="e.g. 1000.00" value="@(Model.CurrentBudget?.ToString("0.00") ?? "")" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Set Budget</button>
    </div>
    @if (ViewData.ModelState.ContainsKey("Budget") && ViewData.ModelState["Budget"]!.Errors.Count > 0)
    {
        <div class="text-danger">@ViewData.ModelState["Budget"]!.Errors[0].ErrorMessage</div>
    }
    @if (Model.CurrentBudget is not null)
    {
        <div class="col-12 mt-2">
            <span class="badge bg-info text-dark">Current budget: @Model.CurrentBudget.Value.ToString("C")</span>
        </div>
    }
</form>

<form method="post" asp-page-handler="AddExpense">
    <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <input type="text" class="form-control" id="description" name="Description" required />
    </div>
    <div class="mb-3">
        <label for="amount" class="form-label">Amount</label>
        <input type="number" step="0.01" class="form-control" id="amount" name="Amount" required />
    </div>
    <button type="submit" class="btn btn-primary">Add Expense</button>
</form>

@{
    var total = Model.Expenses.Sum(e => e.Amount);
    var remaining = Model.CurrentBudget is null ? (decimal?)null : Model.CurrentBudget - total;
}

<div class="mb-3">
    <strong>Total spent:</strong> @total.ToString("C")
    @if (Model.CurrentBudget is not null && remaining.HasValue)
    {
        <span class="ms-3"><strong>Remaining:</strong>
            @if (remaining.Value >= 0)
            {
                <span class="text-success">@remaining.Value.ToString("C")</span>
            }
            else
            {
                <span class="text-danger">Over budget by @Math.Abs(remaining.Value).ToString("C")</span>
            }
        </span>
    }
</div>

@if (Model.Expenses.Any())
{
    <h2>Recent Expenses</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Description</th>
                <th>Amount</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var expense in Model.Expenses)
            {
                <tr>
                    <td>@expense.Description</td>
                    <td>@expense.Amount.ToString("C")</td>
                    <td>@expense.Date.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No expenses recorded yet.</p>
}